{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blitzit",
  "version": "0.4.1",
  "identifier": "app.blitzit.desktop",
  "build": {
    "frontendDist": "https://dulcet-daifuku-0fb870.netlify.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
