  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5QzlGRkNEODkzNEM0NzYKUldSMnhEU0p6Zi9KS2J6b3VSWGF5b3kvZTFXVXVlOE52ZmpyU0xjeDhlY0htV2ZHYUdIdHRraGcK",
      "endpoints": [
        "https://github.com/slymnblk-dev/blitzit-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "blitzit"
        ]
      }
    }
  }
}
